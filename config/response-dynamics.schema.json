{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Restricted response_dynamics_v1 raw experiment configuration",
  "description": "Optional fields receive defaults in validate_config. Cross-field task/role restrictions, unlock < steps, and the 240-request cap are enforced by that validator. The pilot preset uses 900 seconds; legacy default remains 300.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_ids": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["locked-database","database-insider","inventory","schedule","cache-incident","pipeline","campus-security","sensor-fusion","repair-review","diagnostic-contradiction"]}},
    "conditions": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["C0","C1","C2"]}},
    "steps": {"type":"integer","minimum":2,"maximum":8,"default":5},
    "repeats": {"type":"integer","minimum":1,"maximum":5,"default":1},
    "unlock_step": {"type":"integer","minimum":0,"maximum":7,"default":3},
    "adapter": {"enum":["fixture","ollama"]},
    "model": {"type":"string","minLength":1,"maxLength":100},
    "max_output_tokens": {"type":"integer","minimum":80,"maximum":512},
    "seed": {"type":"integer","minimum":0,"maximum":1073741824},
    "schedule": {"enum":["minute_checkpoints","synchronous_snapshot_serial_inference"]},
    "minute_seconds": {"type":"number","exclusiveMinimum":0,"default":60},
    "timeout_seconds": {"type":"number","exclusiveMinimum":0,"default":180},
    "request_timeout_seconds": {"type":["number","null"],"exclusiveMinimum":0,"default":null},
    "deadline_seconds": {"type":"number","exclusiveMinimum":0,"default":300},
    "batch_timeout_seconds": {"type":"number","exclusiveMinimum":0,"default":3600},
    "heartbeat_seconds": {"type":"number","minimum":0.01,"maximum":30,"default":5},
    "logprobs": {"type":"boolean","default":false},
    "engagement_mode": {"enum":["neutral","peer_review","required_peer_check","team_reward","team_individual_reward"]},
    "shared_context_mode": {"enum":["full_history","key_insights_plus_history"]},
    "study_id": {"type":"string","minLength":1,"maxLength":100},
    "communication_budget_bytes": {"type":["integer","null"],"minimum":0,"default":null},
    "communication_delay_steps": {"type":"integer","minimum":0,"maximum":8,"default":0},
    "communication_cost_per_kib": {"type":"number","minimum":0,"default":0},
    "communication_request_required": {"type":"boolean","default":false},
    "role_swap_step": {"type":["integer","null"],"minimum":0,"maximum":7,"default":null},
    "role_mode": {"enum":["specialized","two_solvers"]},
    "evidence_mode": {"enum":["split","identical_complete"]}
  }
}
