{
  "pi": {
    "version": "0.85.1",
    "model": "openai-codex/gpt-5.6-luna",
    "root_env": "APART_PI_ROOT",
    "auth_file_env": "APART_PI_AUTH_FILE",
    "launch_command": ["bun", "run", "{pi_root}/packages/coding-agent/src/cli.ts"],
    "thinking_level": "xhigh"
  },
  "limits": {
    "agent_count": 3,
    "per_agent_token_budget": 4000,
    "per_agent_tool_call_budget": 32,
    "aggregate_token_budget": 12000,
    "aggregate_tool_call_budget": 96,
    "timeout_seconds": 300
  },
  "isolation": {
    "sandbox": "bubblewrap",
    "model_network": true,
    "model_hosts": ["chatgpt.com"],
    "oauth_hosts": ["auth.openai.com"],
    "network": false,
    "shared_filesystem": false,
    "shell": false,
    "subprocess": false,
    "mcp": false,
    "subagents": false
  },
  "conditions": ["C0", "C1", "C2"]
}
