\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Entropy shows that foreign text arrived, for one model}{5}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Decision entropy per turn for each model (rows) and temperature (columns), averaged over 20 runs per condition, with 95\% bootstrap bands. Before the switch turn (dotted line) the three conditions are identical. Each panel gives the AUC with which the change in decision entropy separates runs that received foreign entries (switch and placebo) from base runs; $^*$ marks Holm-corrected $p < 0.05$.\relax }}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:trajectories}{{3}{6}{Decision entropy per turn for each model (rows) and temperature (columns), averaged over 20 runs per condition, with 95\% bootstrap bands. Before the switch turn (dotted line) the three conditions are identical. Each panel gives the AUC with which the change in decision entropy separates runs that received foreign entries (switch and placebo) from base runs; $^*$ marks Holm-corrected $p < 0.05$.\relax }{figure.caption.5}{}}
\newlabel{fig:trajectories@cref}{{[figure][3][]3}{[1][5][]6}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Entropy does not show whether the text was real information}{6}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces AUC for run-level decision-entropy change (0.5 = chance, 1.0 = perfect). Q1: switch and placebo versus base. Q2: switch versus placebo; usable facts are current-task credentials or asset identifiers. These are condition contrasts; the checker separately verifies delivery and use. Bold: significant after Holm correction.\relax }}{6}{table.caption.6}\protected@file@percent }
\newlabel{tab:auc}{{2}{6}{AUC for run-level decision-entropy change (0.5 = chance, 1.0 = perfect). Q1: switch and placebo versus base. Q2: switch versus placebo; usable facts are current-task credentials or asset identifiers. These are condition contrasts; the checker separately verifies delivery and use. Bold: significant after Holm correction.\relax }{table.caption.6}{}}
\newlabel{tab:auc@cref}{{[table][2][]2}{[1][6][]6}}
