\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces What \texttt  {READ\_LOG} returns over a run in each condition. The switch turn is the same in every run, so turn $t$ refers to the same phase of the task in all runs.}}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:conditions}{{2}{5}{What \texttt {READ\_LOG} returns over a run in each condition. The switch turn is the same in every run, so turn $t$ refers to the same phase of the task in all runs}{figure.caption.2}{}}
\newlabel{fig:conditions@cref}{{[figure][2][]2}{[1][3][]5}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces What decision entropy values mean.}}{5}{table.caption.4}\protected@file@percent }
\newlabel{tab:bits}{{1}{5}{What decision entropy values mean}{table.caption.4}{}}
\newlabel{tab:bits@cref}{{[table][1][]1}{[1][5][]5}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Entropy shows that foreign text arrived, for one model}{5}{subsection.4.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces How well the change in decision entropy answers two monitoring questions, as AUC (0.5 = chance, 1.0 = perfect). Q1 compares runs that received foreign entries (switch and placebo) with base runs. Q2 compares real communication (switch) with placebo text. Bold: significant after Holm correction.}}{5}{table.caption.6}\protected@file@percent }
\newlabel{tab:auc}{{2}{5}{How well the change in decision entropy answers two monitoring questions, as AUC (0.5 = chance, 1.0 = perfect). Q1 compares runs that received foreign entries (switch and placebo) with base runs. Q2 compares real communication (switch) with placebo text. Bold: significant after Holm correction}{table.caption.6}{}}
\newlabel{tab:auc@cref}{{[table][2][]2}{[1][5][]5}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Entropy does not show whether the text was real information}{5}{subsection.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}The agents did not become coupled}{5}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Decision entropy per turn for each model (rows) and temperature (columns), averaged over 20 runs per condition, with 95\% bootstrap bands. Before the switch turn (dotted line) the three conditions are identical. Each panel gives the AUC with which the change in decision entropy separates runs that received foreign entries (switch and placebo) from base runs; $^*$ marks Holm-corrected $p < 0.05$.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:trajectories}{{3}{6}{Decision entropy per turn for each model (rows) and temperature (columns), averaged over 20 runs per condition, with 95\% bootstrap bands. Before the switch turn (dotted line) the three conditions are identical. Each panel gives the AUC with which the change in decision entropy separates runs that received foreign entries (switch and placebo) from base runs; $^*$ marks Holm-corrected $p < 0.05$}{figure.caption.5}{}}
\newlabel{fig:trajectories@cref}{{[figure][3][]3}{[1][5][]6}{}{}{}}
