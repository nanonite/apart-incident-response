% sprint-report.sty
%
% Page layout, title block, headers and footers for reports submitted to the
% AI Incident Response Sprint 2026 (Apart Research x CeSIA), Bogota hub hosted
% by AI Safety Colombia: https://aisafetycolombia.org/sprint
%
% Metadata commands (set them in main.tex before \maketitle):
%
%   required: \title{}  \author{}  \authorAnnotation{}  \track{}
%             \articleType{}  \abstrac{}
%   optional: \shortTitle{}  \keywords{}  \selfCitation{}
%             \correspondenceName{}  \correspondenceMail{}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{packages/sprint-report}[2026/09/13 AI Incident Response Sprint report style]


%%%:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
%  Required packages
%%%:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

\RequirePackage{fancyhdr}
\RequirePackage{geometry}
\RequirePackage{graphicx}
\RequirePackage{amsthm}
\RequirePackage{cmbright}
\RequirePackage{cuted}      % full-width title block in two-column mode
\RequirePackage{changepage} % adjustwidth
\RequirePackage{lastpage}   % \pageref{LastPage}


%%%:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
%  Margins
%%%:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

\setlength{\paperwidth}{597.50787pt}
\setlength{\paperheight}{845.04684pt}
\setlength{\textwidth}{497.92322pt}
\setlength{\textheight}{654.41338pt}
\setlength{\oddsidemargin}{-21.33955pt}
\setlength{\evensidemargin}{-21.33955pt}
\setlength{\topmargin}{-28.45274pt}
\setlength{\headheight}{12.49998pt}
\setlength{\headsep}{25.0pt}
\setlength{\topskip}{10.0pt}
\setlength{\footskip}{30.0pt}
\setlength{\marginparwidth}{4.0pt}
\setlength{\marginparsep}{10.0pt}
\setlength{\columnsep}{14.22636pt}


%%%:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
%  Captions
%%%:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

\RequirePackage[font=footnotesize,labelfont=bf,margin=0.1in]{caption}


%%%:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
%  Sprint information
%%%:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

\newcommand{\sprintName}{AI Incident Response Sprint 2026}
\newcommand{\sprintOrganizers}{Apart Research $\times$ CeSIA}
\newcommand{\sprintHub}{Bogot\'a hub \textperiodcentered{} AI Safety Colombia}
\newcommand{\sprintDates}{11--13 September 2026}
\newcommand{\sprintURL}{https://aisafetycolombia.org/sprint}
\newcommand{\sprintLink}{\href{\sprintURL}{\nolinkurl{aisafetycolombia.org/sprint}}}

\newcommand{\sprintfont}{\fontfamily{Montserrat-LF}\selectfont}


%%%:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
%  Metadata commands
%%%:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

\def\keywords#1{\gdef\@keywords{#1}}
\def\shortTitle#1{\gdef\@shortTitle{#1}}
\def\track#1{\gdef\@track{#1}}
\def\articleType#1{\gdef\@articleType{#1}}
\def\authorAnnotation#1{\gdef\@authorAnnotation{#1}}
\def\correspondenceName#1{\gdef\@correspondenceName{#1}}
\def\correspondenceMail#1{\gdef\@correspondenceMail{#1}}
\def\abstrac#1{\gdef\@abstrac{#1}}
\def\selfCitation#1{\gdef\@selfCitation{#1}}

% Defaults
\keywords{}
\shortTitle{}
\track{}
\articleType{}
\authorAnnotation{}
\correspondenceName{}
\correspondenceMail{}
\abstrac{}
\selfCitation{}


%%%:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
%  \maketitle
%%%:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

\renewcommand{\maketitle}{%
\clearpage

%- PDF metadata::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
\hypersetup{
	pdftitle={\@title},
	pdfsubject={\sprintName},
	pdfkeywords={\@keywords}
}

%- Running headers and footers::::::::::::::::::::::::::::::::::::::::::::::::::::
\pagestyle{fancy}
\fancyhf{}
\ifx\@shortTitle\empty
	\fancyhead[RE,LO]{\@title}
\else
	\fancyhead[RE,LO]{\@shortTitle}
\fi
\fancyhead[LE,RO]{\thepage}
\fancyfoot[L]{\small{\sprintfont\bfseries\@track}}
\fancyfoot[R]{\small{\sprintfont\bfseries\sprintLink}}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Keep footnotes from breaking across pages
\interfootnotelinepenalty=10000

%- First page style:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
\fancypagestyle{firststyle}{
	\fancyhf{}
	\fancyhead[L]{\@selfCitation}
	\fancyfoot[L]{
		\ifx\@correspondenceName\empty
		\else
		\begin{adjustwidth}{-0mm}{}\footnotesize\emph{*Correspondence to}: \@correspondenceName{} (\href{mailto:\@correspondenceMail}{\@correspondenceMail})\end{adjustwidth}
		\fi
		{\sprintfont\large\bfseries\sprintName}
	}
}

%- Title block::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
\begin{strip}
	\vspace{-0.8cm}
	\begin{adjustwidth}{-2mm}{}
	\begin{tabular*}{\textwidth}{@{}l@{\extracolsep{\fill}}r@{}}
		{\sprintfont\bfseries\sprintName} & {\sprintfont\bfseries\@track} \\
		\sprintOrganizers & \sprintDates \\
		\sprintHub & \sprintLink \\
	\end{tabular*}
	\end{adjustwidth}
	\vspace{1mm}
	\noindent\rule{\textwidth}{0.5pt}\\[2mm]
	\noindent\emph{\@articleType}\\

	\noindent\Large{\sprintfont\bfseries{\@title}}\\

	\noindent\normalsize{\sprintfont\bfseries{\@author}}\\
	\textit\@authorAnnotation
	\vspace{2mm}
\end{strip}

\thispagestyle{firststyle}

%- Abstract and keywords::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
% A rule is drawn below the keywords, or below the abstract if there are no
% keywords.
\ifx\@abstrac\empty
\else
	\noindent {\sprintfont\bfseries{Abstract. }}\@abstrac\\
	\vspace{-1ex}
\fi

\ifx\@keywords\empty
	\ifx\@abstrac\empty
	\else
		\noindent \rule{\columnwidth}{0.5pt}
	\fi
\else
	\noindent {\sprintfont\bfseries{Keywords: }}\@keywords\\
	\noindent \rule{\columnwidth}{0.5pt}
\fi
}

\endinput
